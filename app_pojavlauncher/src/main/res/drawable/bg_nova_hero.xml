<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0A14" />
        </shape>
    </item>
    <item android:gravity="center" android:width="480dp" android:height="480dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:startColor="#55A855F7"
                android:centerColor="#1AA855F7"
                android:endColor="#000D0A14" />
        </shape>
    </item>
</layer-list>
